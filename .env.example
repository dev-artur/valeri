# Project ID from sanity.io/manage. Leave empty to run on mock data.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret for the Sanity webhook → /api/revalidate (any long random string)
SANITY_REVALIDATE_SECRET=

# Public site URL for the sitemap and social previews.
# Optional on Vercel: defaults to the project's production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
