# ID проекта из sanity.io/manage. Пока пусто — сайт работает на тестовых данных.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Секрет вебхука Sanity → /api/revalidate (любая длинная случайная строка)
SANITY_REVALIDATE_SECRET=

# Публичный адрес сайта для sitemap и превью в соцсетях.
# На Vercel можно не задавать — возьмётся адрес проекта (*.vercel.app или свой домен).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
